# Copy to .env for local development. Never commit .env.
# These are read server-side by Netlify Functions only. Do NOT prefix them with
# VITE_, or Vite will bundle them into the public site.

# Anthropic API key from platform.claude.com (NFR-12). A Claude.ai subscription
# doesn't include API access.
ANTHROPIC_API_KEY=

# Claude model per language (NFR-8). Leave empty for the defaults:
# claude-sonnet-5-5 for Spanish, claude-haiku-5-5 for English.
MODEL_NAME_ES=
MODEL_NAME_EN=

# true = return a canned verse instead of calling Claude (DX-2)
USE_MOCK_MODEL=true

# Generations allowed per visitor every 10 minutes (NFR-3). Default 10.
# Raise it locally if the limit gets in the way while developing.
RATE_LIMIT_MAX=

# Random string mixed into the hashed visitor IPs used for rate limiting, so
# the stored keys can't be traced back to an IP. Set a long random value.
RATE_LIMIT_SALT=
