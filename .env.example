# Copy to .env for local development. Never commit .env.
# These are read server-side by Netlify Functions only. Do NOT prefix them with
# VITE_, or Vite will bundle them into the public site.

# Model access key for DigitalOcean serverless inference (NFR-12). Create one in
# the DigitalOcean control panel. For a local server like Ollama, any value works.
MODEL_ACCESS_KEY=

# Open-weight model that writes the verses (NFR-8). Default gemma-4-31B-it.
MODEL_NAME=

# OpenAI-compatible endpoint. Default https://inference.do-ai.run/v1.
# For Ollama running Gemma locally: http://localhost:11434/v1, with MODEL_NAME set
# to the Gemma tag you pulled.
INFERENCE_BASE_URL=

# true = return a canned verse instead of calling the model (DX-2)
USE_MOCK_MODEL=true

# Generations allowed per visitor every 10 minutes (NFR-3). Default 10.
# Raise it locally if the limit gets in the way while developing.
RATE_LIMIT_MAX=

# Random string mixed into the hashed visitor IPs used for rate limiting, so
# the stored keys can't be traced back to an IP. Set a long random value.
RATE_LIMIT_SALT=
